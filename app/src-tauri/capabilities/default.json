{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-screens",
  "description": "The app's own screens (setup, folders, indexing, settings).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-state",
    "allow-setup-runtime",
    "allow-list-roots",
    "allow-start-index",
    "allow-start-engine",
    "allow-stop-engine",
    "allow-open-path",
    "allow-open-data-dir",
    "allow-save-folders",
    "allow-load-folders",
    "allow-uninstall-data",
    "allow-quit-app",
    "allow-upgrade-state",
    "allow-set-upgrade",
    "allow-read-progress",
    "allow-set-pause",
    "allow-set-lang",
    "allow-saved-lang-choice"
  ]
}
